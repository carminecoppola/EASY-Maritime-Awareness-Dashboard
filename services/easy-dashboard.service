[Unit]
Description=EASY Maritime Awareness Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Desktop/carmine/easy-dashboard
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/Desktop/carmine/easy-dashboard/start.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
