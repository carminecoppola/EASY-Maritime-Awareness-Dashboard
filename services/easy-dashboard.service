#
# systemd unit TEMPLATE. Do not copy it by hand: scripts/install_service.sh renders
# @PROJECT_DIR@ (this checkout) and @SERVICE_USER@ (the installing user) and installs
# it as /etc/systemd/system/easy-dashboard.service.
[Unit]
Description=EASY Maritime Awareness Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=EASY_OPEN_BROWSER=0
Environment=EASY_ONNX_THREADS=4
ExecStart=@PROJECT_DIR@/scripts/run_service.sh
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=10
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
