# EASY Maritime Awareness Dashboard - launcher settings.
#
# Copy this file to ~/.config/easy/launcher.env and adapt the values.
# Environment variables with the same names take precedence over this file.

# Optional jump host. Leave EASY_JUMP_HOST empty to connect directly.
EASY_JUMP_USER=
EASY_JUMP_HOST=
EASY_JUMP_PORT=22

# Raspberry Pi, as reachable from the jump host (or from this Mac if there is none).
EASY_TARGET_USER=pi
EASY_TARGET_HOST=raspberrypi.local
EASY_TARGET_PORT=22

# Where the dashboard is installed on the Raspberry, and the port Flask listens on.
EASY_REMOTE_PROJECT=/home/pi/easy-dashboard
EASY_REMOTE_APP_PORT=5000

# First local port to try for the SSH tunnel (the next 49 ports are tried too).
EASY_LOCAL_PORT=5500

# Browser application name, e.g. Safari or "Google Chrome". Empty = system default.
EASY_BROWSER=

# Timing (seconds) and retry behaviour.
EASY_STARTUP_TIMEOUT_SECONDS=45
EASY_DEGRADED_START_DELAY_SECONDS=5
EASY_SSH_RETRIES=3
EASY_SSH_RETRY_DELAY_SECONDS=3
